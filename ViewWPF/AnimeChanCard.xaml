<Window x:Class="ViewWPF.AnimeChanCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ViewWPF"
        mc:Ignorable="d"
        Title="Инфа о тянке" Height="586" Width="524">
    <Grid>
        <TextBlock HorizontalAlignment="Center" Margin="0,21,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="22" Width="114" Text="Имя-фамилия" FontSize="16" FontWeight="SemiBold"/>
        <TextBox HorizontalAlignment="Center" Margin="0,65,0,0" TextWrapping="Wrap" Text="Имя" VerticalAlignment="Top" Width="330" Height="26"/>
        <TextBox HorizontalAlignment="Center" Margin="0,98,0,0" TextWrapping="Wrap" Text="Фамилия" VerticalAlignment="Top" Width="330" Height="27"/>
        <TextBlock
            HorizontalAlignment="Center" Margin="0,147,0,0" Width="66" VerticalAlignment="Top" TextWrapping="Wrap" Height="22" FontSize="16" FontWeight="SemiBold"><Run
                Language="ru-ru" Text="Данные"/></TextBlock>
        <TextBox HorizontalAlignment="Left" Margin="192,188,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="222" Height="27" TextChanged="TextBox_TextChanged"/>
        <TextBox HorizontalAlignment="Left" Margin="192,220,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="222" Height="27"/>
        <TextBox HorizontalAlignment="Left" Margin="192,253,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="222" Height="27"/>
        <TextBox HorizontalAlignment="Left" Margin="192,285,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="222" Height="27"/>
        <Button Content="Выбрать её" HorizontalAlignment="Center" Margin="0,501,0,0" VerticalAlignment="Top" Height="59" Width="330" FontSize="18" Click="Button_Click"/>
        <TextBlock
            HorizontalAlignment="Left" Margin="120,189,0,0" Width="68" VerticalAlignment="Top" TextWrapping="Wrap" Height="23" FontSize="16"><Run Language="ru-ru" Text="Возраст"/></TextBlock>
        <TextBlock
            HorizontalAlignment="Left" Margin="120,221,0,0" Width="68" VerticalAlignment="Top" TextWrapping="Wrap" Height="23" FontSize="16"><Run Language="ru-ru" Text="Рост"/></TextBlock>
        <TextBlock
            HorizontalAlignment="Left" Margin="120,253,0,0" Width="68" VerticalAlignment="Top" TextWrapping="Wrap" Height="22" FontSize="16"><Run Language="ru-ru" Text="Вес"/></TextBlock>
        <TextBlock
            HorizontalAlignment="Left" Margin="120,285,0,0" Width="68" VerticalAlignment="Top" TextWrapping="Wrap" Height="23" FontSize="16"><Run Language="ru-ru" Text="Размер"/></TextBlock>
        <TextBlock HorizontalAlignment="Center" Margin="0,332,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="20" Width="72"><Run Language="ru-ru" Text="Навыки:"/></TextBlock>
        <TextBox HorizontalAlignment="Center" Margin="0,372,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="362" Height="107" RenderTransformOrigin="0.569,0.932"/>

    </Grid>
</Window>
