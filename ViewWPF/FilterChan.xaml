        <TextBlock HorizontalAlignment="Left" Margin="229,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="20" Grid.Column="1"><Run Language="ru-ru" Text="До"/></TextBlock>
        <TextBlock HorizontalAlignment="Center" Margin="0,159,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="20" Width="88"><Run Language="ru-ru" Text="Вес"/><Run Text=":"/></TextBlock>
