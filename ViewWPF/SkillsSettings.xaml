<Window x:Class="ViewWPF.SkillsSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ViewWPF"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Title="SkillsSettings" Height="450" Width="623">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="111*"/>
            <ColumnDefinition Width="512*"/>
        </Grid.ColumnDefinitions>
        <TextBlock TextAlignment="Center" HorizontalAlignment="Left" Margin="71,32,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="35" Width="258" FontSize="18" Grid.Column="1" Text="Выбери навык"/>
        <ComboBox HorizontalAlignment="Center" Margin="0,72,0,0" VerticalAlignment="Top" Width="561" Grid.ColumnSpan="2" ItemsSource="{Binding AllSkills}" SelectedItem="{Binding SelectedSkill}"/>
        <ListView ItemsSource="{Binding CurrentSkills}" Margin="82,161,83,116" Grid.ColumnSpan="2" SelectedItem="{Binding SelectedCurrentSkill}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Content="Добавить" HorizontalAlignment="Left" Margin="31,343,0,0" VerticalAlignment="Top" Click="Button_Click" Grid.ColumnSpan="2" Height="60" Width="118" RenderTransformOrigin="0.565,0.642" Command="{Binding AddSkillCommand}"/>
        <TextBlock TextAlignment="Center" HorizontalAlignment="Left" Margin="71,126,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="35" Width="258" FontSize="18" Grid.Column="1"><UIElement.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </UIElement.RenderTransform><Run Language="ru-ru" Text="Навыки"/></TextBlock>
        <Button Content="Удалить" HorizontalAlignment="Left" Margin="141,343,0,0" VerticalAlignment="Top" Click="Button_Click" Height="60" Width="118" RenderTransformOrigin="0.565,0.642" Grid.Column="1" Command="{Binding RemoveSkillCommand}"/>
        <Button Content="Сохранить" HorizontalAlignment="Left" Margin="363,343,0,0" VerticalAlignment="Top" Click="Button_Click" Height="60" Width="118" RenderTransformOrigin="0.565,0.642" Grid.Column="1" Command="{Binding SaveCommand}"/>

    </Grid>
</Window>