<Window x:Class="ViewWPF.Error"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ViewWPF"
        mc:Ignorable="d"
        Title="Error" Height="326" Width="428">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24*"/>
            <ColumnDefinition Width="235*"/>
            <ColumnDefinition Width="169*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="100,45,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Grid.ColumnSpan="2" Width="191" FontSize="29" TextAlignment="Center"><Run Language="ru-ru" Text="ОШИБКА!"/></TextBlock>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="100,89,0,0" TextWrapping="Wrap" Text="{Binding Error}" VerticalAlignment="Top" Width="191" Grid.ColumnSpan="2" TextAlignment="Center" FontSize="16"/>

    </Grid>
</Window>
